+def termination_equivalent_kl_rows(hs, ws, ht, wt):
+    """KL on observable actions, retaining unmodified vocabulary KL diagnostics.
+
+    For stop class E, use log(P(E)/Q(E)) for every i in E. The logit
+    derivative is p_i * (class_log_ratio_i - coarse_KL); all other actions
+    and the ordinary full-vocabulary normalization remain unchanged.
+    """
+    ids = termination_equivalence_ids()
+    if len(ids) < 2 or max(ids) >= len(ws):
+        raise ValueError("Termination equivalence requires supported stopping IDs")
+    lp = project(hs, ws).log_softmax(-1)
+    lt = project(ht, wt).log_softmax(-1)
+    stop_gap = lp[:, ids].logsumexp(-1) - lt[:, ids].logsumexp(-1)
+    p = lp.exp()
+    lp.sub_(lt)
+    del lt
+    raw_kl = (p * lp).sum(-1)
+    lp[:, ids] = stop_gap[:, None]
+    coarse_kl = (p * lp).sum(-1)
+    lp.sub_(coarse_kl[:, None]).mul_(p)
+    return coarse_kl, lp.to(hs.dtype), raw_kl
+
+
