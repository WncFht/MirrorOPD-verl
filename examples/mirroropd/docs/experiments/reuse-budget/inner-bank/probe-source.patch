+    def _prefix_is_output(self, micro_batch, model_inputs):
+        """Read selected response probabilities through a bounded native head callback."""
+        from examples.mirroropd.tools.prefix_is_probe import selected_token_log_probs
+        from verl.workers.utils.padding import prediction_positions
+
+        responses = micro_batch["responses"]
+        ones = torch.nested.as_nested_tensor(
+            [torch.ones_like(r) for r in responses.unbind()], layout=torch.jagged
+        )
+        positions, packed = prediction_positions(micro_batch["input_ids"], ones)
+        actions = responses.values()
+        if not hasattr(self, "_prefix_is_legal_ids"):
+            self._prefix_is_legal_ids = sorted(set(self.model_config.tokenizer.get_vocab().values()))
+
+        def output(hidden, head):
+            selected = hidden.squeeze(0).index_select(0, packed)
+
+            def project(h, w):
+                values = selected_token_log_probs(h, w, actions, self._prefix_is_legal_ids)
+                chunks = values.split([len(p) for p in positions])
+                return {"prefix_log_probs": torch.nested.as_nested_tensor(list(chunks), layout=torch.jagged)}
+
+            return head(selected, full_vocab_callback=project)
+
+        return self.module(**model_inputs, use_cache=False, full_vocab_callback=output)
+
